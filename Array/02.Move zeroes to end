Javascript:
var moveZeroes = function(nums) {
    let k = 0;
    for(let i = 0; i < nums.length; i++) {
        if(nums[i] != 0) {
            [nums[i], nums[k]] = [nums[k], nums[i]];
            k++;
        }
    }
    return nums;
};
