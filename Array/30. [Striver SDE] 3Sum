Javascript:
var threeSum = function(nums) {
    let result = [];
    if(nums.length < 3) return result;

    nums.sort((a, b) => a - b);

    let target = 0; //later we can have custom target too
    for(let i = 0; i < nums.length - 2; i++) {
        if(nums[i] > target) break; //as already sorted so no need to go further
        if(i > 0 && nums[i] ===nums[i-1]) continue; //no duplicates, otherwise we might get the same nums[j] & nums[k]
        let j = i + 1;
        let k = nums.length - 1;
        while (j < k) {
            let sum = nums[i] + nums[j] + nums[k];
            if(sum === target) {
                result.push([nums[i], nums[j], nums[k]]);
                while (nums[j] === nums[j+1]) j++; //removing the duplicates
                while (nums[k] === nums[k-1]) k--; 
                j++;
                k--;
            } else if (sum < target) {
                j++;
            } else {
                k--;
            }
        }
    }
    return result;
};
