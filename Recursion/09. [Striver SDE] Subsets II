Solution 2: Best approach
- Each recursive level is one set.
- for eg: 1,2,2,3,3
-- 0th level = []
-- 1st level = [1],[2],[2],[3],[3]
-- 2nd level = [1,2], [1,2], [1,3], [1,3], [2,2], [2,3], [2,3], [2,3], [3,3]
-- as you can see, so many duplicate sets at each level.
-- to solve this, add if(i != ind && nums[i] == nums[i-1])
---- make sure to sort nums before recursion. 

var subsetsWithDup = function(nums) {
    let ans = [];
    nums.sort((a,b) => a - b);
    subset(0, [], ans, nums)
    return ans;
};

function subset(ind, subSt, ans, nums) {
    ans.push(subSt);
    for(let i = ind; i < nums.length; i++) {
        if(i != ind && nums[i] == nums[i-1]) {
            continue;
        }
        subset(i+1, [...subSt, nums[i]], ans, nums);
    }
}
